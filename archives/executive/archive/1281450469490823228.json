    {
      "id": "1281544787584876590",
      "type": "Default",
      "timestamp": "2024-09-06T09:21:27.311+00:00",
      "timestampEdited": "2024-09-06T09:24:48.127+00:00",
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "Voted nay on both this and the other one. I’m a raider, obviously (though I’ve parked my WA in TEP given my roles here), so I was always going to be against, but in the interest of stirring perhaps some debate on this matter, I also see this as an extension of the current state of the game.",
      "author": {
        "id": "362575320559386634",
        "name": "jowhatup",
        "discriminator": "0000",
        "nickname": "joWhatup",
        "color": null,
        "isBot": false,
        "roles": [],
        "avatarUrl": "https://cdn.discordapp.com/avatars/362575320559386634/f5bb91b8570ccd9af16a7c917d65fee7.png?size=512"
      },
      "attachments": [],
      "embeds": [],
      "stickers": [],
      "reactions": [],
      "mentions": [],
