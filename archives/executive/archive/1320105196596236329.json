    {
      "id": "1320116643321614388",
      "type": "Default",
      "timestamp": "2024-12-21T19:52:14.349+00:00",
      "timestampEdited": null,
      "callEndedTimestamp": null,
      "isPinned": false,
      "content": "Voted for, personally. I'd probably have voted against a few years ago (if memory serves, Hame is a rather traditional moralist with a tendency to hurl toxic commentary towards raiders), but at least on this one the commendation is well-earned, which I've come to appreciate more and more in the current era of personal/politically motivated repeals and the endless flood of \"said hi in Euro\" commends.",
      "author": {
        "id": "362575320559386634",
        "name": "jowhatup",
        "discriminator": "0000",
        "nickname": "joWhatup",
        "color": null,
        "isBot": false,
        "roles": [],
